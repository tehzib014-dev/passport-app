<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Login</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="passport-page auth-page min-h-screen bg-slate-50 px-4 py-8 text-slate-800 sm:px-6">
    <%- include('includes/header') %>
    <main class="auth-layout flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center gap-4">

        <%- messages() %>

        <form action="/users/login" method="post" class="auth-panel w-full max-w-md space-y-5 rounded-lg bg-white p-6 shadow-sm sm:p-8">
            <h2 class="auth-title text-2xl font-semibold">User Login</h2>
            <div class="space-y-2">
            <label class="auth-label block text-sm font-medium">Username:</label>
            <input class="auth-input w-full rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" type="text" name="username" placeholder="Username" autofocus required>
            </div>
            <div class="space-y-2">
            <label class="auth-label block text-sm font-medium">Password:</label>
            <input class="auth-input w-full rounded-md border border-slate-300 px-3 py-2 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" type="password" name="password" placeholder="Password" required>
            </div>
            <p class="auth-prompt text-sm text-slate-600">No account? <a class="auth-link font-medium text-blue-700 hover:text-blue-800 hover:underline" href="/users/register">Register here</a></p>
            <button class="auth-submit w-full rounded-md bg-blue-700 px-4 py-2.5 font-medium text-white transition-colors hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" type="submit">Sign in</button>
        </form>
    </main>
    <%- include('includes/footer') %>
</body>
</html>